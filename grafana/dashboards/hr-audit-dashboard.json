{
  "id": null,
  "uid": "hr-audit-dashboard",
  "title": "HR Audit & Administrative Actions",
  "tags": ["security", "hr", "audit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total HR Actions (Last 1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(increase(audit_log_events_total[1h]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 }
      }
    },
    {
      "id": 2,
      "title": "Actions Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        { "expr": "sum(increase(audit_log_events_total[5m])) by (action)", "legendFormat": "{{action}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 3,
      "title": "Permanent Deletes",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        { "expr": "increase(audit_log_events_total{action=\"PERMANENT_DELETE\"}[1h])", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "red", "value": null }]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Deactivate vs Restore",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(increase(audit_log_events_total{action=\"DEACTIVATE\"}[5m]))", "legendFormat": "Deactivate" },
        { "expr": "sum(increase(audit_log_events_total{action=\"RESTORE\"}[5m]))", "legendFormat": "Restore" }
      ]
    }
  ]
}